# Base URL of the VOIP.dog backend API (must end with /api)
VOIPDOG_API_BASE_URL=https://api.voip.dog/api

# --- Authentication (choose ONE) ---

# Option A: Pre-created session token (Bearer). 7-day lifetime.
# Obtain via POST /api/auth/signin and copy the `sessionToken` from the response.
VOIPDOG_SESSION_TOKEN=

# Option B: Email + password — MCP auto-signs in and refreshes.
# Only works for accounts with provider="email" (not Azure/Google SSO accounts).
VOIPDOG_EMAIL=
VOIPDOG_PASSWORD=

# --- Optional ---

# Override organization id (only needed when calling internal/service routes).
# For normal user calls, the backend auto-resolves org from the session.
# VOIPDOG_ORGANIZATION_ID=

# HTTP transport bind (used only with --http flag).
# MCP_HTTP_PORT=8765
# MCP_HTTP_HOST=127.0.0.1

# Verbose logging to stderr (stdio mode keeps stdout clean for MCP framing).
# VOIPDOG_MCP_DEBUG=1
